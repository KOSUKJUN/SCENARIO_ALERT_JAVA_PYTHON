# docker compose 가 읽는 값. 복사해서 .env 로 쓴다 (커밋하지 않는다). 모두 개발용 기본값.
# 포트가 겹치면 바꾼다
WEB_HOST_PORT=8080
API_HOST_PORT=8000
MARIADB_HOST_PORT=3306
CH_HOST_PORT=8123
MOCKCASE_HOST_PORT=8090

# 접속 정보
MARIADB_ROOT_PASSWORD=root_pw
MARIADB_USER=detect
MARIADB_PASSWORD=detect_pw
DICT_PASSWORD=dict_pw
CH_USER=detect
CH_PASSWORD=detect_pw
CH_BT_USER=detect_bt
CH_BT_PASSWORD=detect_bt_pw
CH_ADMIN_USER=default
CH_ADMIN_PASSWORD=admin_pw
CASE_SERVICE_TOKEN=case-service-token

# 초기화 (init)
SEED_SAMPLE=true
SAMPLE_HOURS=2
BUILTIN_STATUS=active

# 시나리오 평가용 Python 상주 프로세스 수 (서버 1대당)
PYTHON_WORKERS=2
