<clickhouse>
    <timezone>Asia/Seoul</timezone>
    <logger><level>warning</level></logger>
    <!-- MariaDB 접속 정보: 딕셔너리 SQL에는 쓰지 않고 named collection 으로만 참조한다 -->
    <named_collections>
        <mariadb_detect>
            <host>mariadb</host>
            <port>3306</port>
            <user>detect_dict</user>
            <password from_env="DICT_PASSWORD"/>
            <db>detect</db>
        </mariadb_detect>
    </named_collections>
    <!-- 테스트 전용: 운영 원본 테이블(Distributed)이 가리키는 클러스터 이름을 노드 하나로 흉내 낸다.
         로컬 복제본이라 조회·적재는 네트워크 없이 이 노드의 log_integrated_success_store 로 간다 (prefer_localhost_replica). -->
    <remote_servers>
        <codvill_cluster>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </codvill_cluster>
    </remote_servers>
</clickhouse>
