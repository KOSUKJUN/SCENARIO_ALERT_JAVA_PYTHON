<clickhouse>
    <profiles>
        <!-- 실시간 탐지: 실행 시간 30초, 메모리 상한 -->
        <detect>
            <max_execution_time>30</max_execution_time>
            <max_memory_usage>4000000000</max_memory_usage>
            <priority>1</priority>
        </detect>
        <!-- 백테스트: 낮은 우선순위, 더 낮은 메모리 상한 -->
        <detect_bt>
            <max_execution_time>300</max_execution_time>
            <max_memory_usage>2000000000</max_memory_usage>
            <priority>10</priority>
        </detect_bt>
    </profiles>
    <users>
        <detect>
            <password from_env="CH_PASSWORD"/>
            <profile>detect</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON codlog.log_integrated_success_all</query>
                <query>GRANT SELECT, INSERT, ALTER DELETE, dictGet ON detect.*</query>
                <!-- 경보 본문 테이블: 넣기, 등급 상향 때 이전 행 지우기(가벼운 DELETE 는 ALTER UPDATE(_row_exists) 권한도 쓴다) -->
                <query>GRANT SELECT, INSERT, ALTER DELETE, ALTER UPDATE ON codlog.alert_integrated_all</query>
                <query>GRANT SYSTEM RELOAD DICTIONARY ON *.*</query>
            </grants>
        </detect>
        <detect_bt>
            <password from_env="CH_BT_PASSWORD"/>
            <profile>detect_bt</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON codlog.log_integrated_success_all</query>
                <query>GRANT SELECT, INSERT, ALTER DELETE, dictGet ON detect.*</query>
            </grants>
        </detect_bt>
    </users>
</clickhouse>
